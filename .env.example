# Local development only. Copy to .env and fill in. Deployed values live in
# Vercel, one set per environment (README.md, "Environments").
#
# Every value here must belong to the SAME environment. Never put a production
# key in a development or staging deployment (spec S-8, S-26).

# --- Baked into the browser bundle at build time (vite.config.ts `define`) ---
# Public values only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# development | staging | production. Shown on every screen (NFR-8).
APP_ENV=development

# --- Read by the server at request time, never bundled (added in Phase 1) ---
# Bypasses all row-level security. Read only by src/lib/supabase-admin.server.ts (S-11).
# SUPABASE_SERVICE_ROLE_KEY=
# hCaptcha for sign-in and password reset (S-3).
# HCAPTCHA_SITE_KEY=
# HCAPTCHA_SECRET=
