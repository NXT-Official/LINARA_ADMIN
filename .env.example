# LINARA_ADMIN environment variables.
#
# Local setup: copy this file to `.env` (git never tracks .env) and fill it in.
# Deployed: the same names go into Vercel, one set per environment.
#
# Every value in one file must come from the SAME environment. Never put a
# production key in a development or staging setup (spec S-8, S-26).
#
# Supabase projects: "linara dev" for development, "linara prod" for production.
# A local .env always uses linara dev. There is no staging project yet (OQ-10).

# ------------------------------------------------------------------------------
# PUBLIC: baked into the browser bundle at build time. Safe to be seen.
# ------------------------------------------------------------------------------

# Supabase > linara dev > Project Settings > Data API > Project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase > Project Settings > API Keys > "anon public" key (legacy tab), or a
# publishable key (sb_publishable_...), from the same project as SUPABASE_URL.
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# development | staging | production. Shown on every screen (NFR-8).
APP_ENV=development

# hCaptcha site key, for the sign-in and reset forms (S-3).
# Local development: hCaptcha's official test key below always passes.
HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# ------------------------------------------------------------------------------
# SERVER ONLY: read at request time, never sent to the browser.
# ------------------------------------------------------------------------------

# The console's own address. Password-reset and invite links only return here
# (S-4). Must also be listed in Supabase > Authentication > URL Configuration >
# Redirect URLs.
SITE_URL=http://localhost:8081

# Supabase > Project Settings > API Keys > Secret keys > a key made for the
# console only (sb_secret_...), or the legacy "service_role" key.
# It bypasses every database rule: read in one server module only (S-11), never
# logged, never pasted into chat, email or a ticket.
SUPABASE_SERVICE_ROLE_KEY=

# hCaptcha secret for the site key above.
# Local development: hCaptcha's official test secret below.
HCAPTCHA_SECRET=0x0000000000000000000000000000000000000000

# The console's own emails (D45): team member added or removed, CRM contacts
# exported. Sent through Resend (resend.com > API Keys > "Sending access" key).
# Left empty in development, nothing is sent. Required in production.
RESEND_API_KEY=

# The sender. Empty means Resend's test sender (onboarding@resend.dev), which
# only delivers to the email that owns the Resend account. Production needs an
# address on Linara's own domain, verified in Resend > Domains.
# EMAIL_FROM=Linara Business Console <noreply@linara.site>

# Development and staging only: every console email goes to this address
# instead (use the Resend account's own email while on the test sender).
# EMAIL_TEST_RECIPIENT=

# ------------------------------------------------------------------------------
# BROWSER TESTS ONLY: put these in a separate `.env.e2e` (git never tracks it).
# A dedicated test admin on linara dev, never a real admin's account.
# ------------------------------------------------------------------------------
# E2E_ADMIN_EMAIL=
# E2E_ADMIN_PASSWORD=
# E2E_ADMIN_TOTP_SECRET=   (the key shown under the QR code when the test admin set up two-step)
# E2E_SUSPEND_USER_ID=     (optional: a throwaway linara dev account the suspend test bans and unbans)